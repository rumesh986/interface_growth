#!/bin/bash

# Basic run script, expects two input arguments
# 	first one should be the name of the program being built by make
# 	The second is the number of steps this solver will run for


if [[ $# != 2 ]]
then
	echo "Not enough arguments, exiting ..."
	exit 1
fi

make $1

if [[ $? != 0 ]]
then
	echo "Make failed"
	exit 2
fi

rm -rf RESLT/*

dt=0.0001
nx=10

for nx in 10 100 1000 10000 100000
# for dt in 1e-2 1e-4
do
	./$1 --nx $nx --dt $dt --tsteps $2 >> RESLT/n$nx\_t$dt.stdout &
	# ./$1 --nx $nx --dt $dt --tsteps $2 | tee RESLT/n$nx\_t$dt.stdout &

	if [[ $? != 0 ]]
	then
		echo "Run failed"
		exit 3
	fi
done

wait

./visualizer $1 $2