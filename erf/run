#!/bin/bash

set -E
# trap '_error_exit' ERR
trap "echo sigkill recvd in $BASHPID" SIGKILL

function _error_exit {
	echo "Some kind of error experienced in ${BASHPID}, exiting..."
	exit 77
}

# Run script for different configurations
# 	first input should always be the name of the program to compile

# build function
# $1 -> name of program (Pass in $1 from cmdline args)
# $2 -> time scheme order (BDF number)
# $3 -> space scheme order (NNodes per element)
function _build {
	CXXFLAGS=$(cat Makefile | sed -rn s/^CXXFLAGS.*=\(.*\)/\\1/p)
	make $1 CXXFLAGS="$CXXFLAGS -DT_ORDER=$2 -DX_ORDER=$3"

	if [[ $? != 0 ]]
	then
		echo "Make failed [$@]"
		exit 1
	fi
}

# run single configuration
# $1 -> name of program (Pass in $1 from cmdline args)
# $2 -> number of nodes (nx)
# $3 -> time step size (dt)
# $4 -> number of time steps (t_steps)
# $5 -> starting time (t_shift)
# $6 -> write frequency
# $7 -> output file (stdout redirect)
function _run {
	echo -e "Running $1 with nx=$2, dt=$3 for $4 steps in $BASHPID"

	if [[ $3 = 0.0 ]]
	then
		dt="--vardt"
	else
		dt="--dt $3"
	fi

	./$1 --nx $2 $dt --tsteps $4 --tshift $5 --write-freq $6 >> $7
	ret=$?

	if [[ $ret != 0 ]]
	then
		echo "Run Failed"
		exit $ret
	fi

	return $ret
}

# standard run (single config)
# $1 -> name of program (Pass in $1 from cmdline args)
# $2 -> number of steps (pass in $2 from cmdline args)
function _standard {
	T_ORDER=2
	X_ORDER=2

	make mostlyclean-compile

	_build $1 $T_ORDER $X_ORDER

	rm -rf RESLT/*

	nx=10
	dt=0.01
	tshift=0.0
	stdoutfile="RESLT/${X_ORDER}x${nx}_${T_ORDER}t${dt}.stdout"

	_run $1 $nx $dt $2 $tshift 1 $stdoutfile

	./visualizer $1 a
}

function _dx_analysis {
	T_ORDER=2
	dt=0.0001
	tshift=0.0
	
	rm -rf RESLT/*
	
	pids=()
	for X_ORDER in 2 3 4
	do
		make mostlyclean-compile
		_build $1 $T_ORDER $X_ORDER

		for nx in 10 50 80 100 500 800 1000 5000
		do
			stdoutfile="RESLT/${X_ORDER}x${nx}_${T_ORDER}t${dt}.stdout"
			echo $stdoutfile
			_run $1 $nx $dt $2 $tshift 1 $stdoutfile &
			pids+="$! "
		done

		for pid in $pids
		do
			wait $pid

			if [[ $? != 0 ]]
			then
				echo "run failed in dx analysis, exiting..."
				kill 0
				exit 1
			fi
		done
	done	

	./visualizer $1 x
}

function _dt_analysis {
	X_ORDER=2
	nx=1000
	tshift=0.0
	
	rm -rf RESLT/*
	
	pids=()
	for T_ORDER in 1 2 4
	do
		make mostlyclean-compile
		_build $1 $T_ORDER $X_ORDER


		tshift=$(echo "($T_ORDER+1)*0.1" | bc)

		t1=$(echo "$2/0.1" | bc -l)

		for dtp in -1 -2 -3 -4
		do
			dt=$(echo "10.0 ^ $dtp" | bc -l)
			tsteps=$(echo "$2/$dt" | bc)
			wf=$(echo "$tsteps/$t1" | bc)
			# tsteps=$2
			stdoutfile="RESLT/${X_ORDER}x${nx}_${T_ORDER}t${dt}.stdout"

			echo $stdoutfile $tshift
			_run $1 $nx $dt $tsteps $tshift $wf $stdoutfile &
			pids+="$! "
		done

		for pid in $pids
		do
			wait $pid

			if [[ $? != 0 ]]
			then
				echo "run failed in dx analysis, exiting..."
				kill 0
				exit 1
			fi
		done
	done	

	./visualizer $1 t
}

function _dxdt_analysis {
	T_ORDER=2
	dt=0.0
	tshift=0.0
	
	rm -rf RESLT/*
	
	pids=()
	for X_ORDER in 2 # 3 4
	do
		rm $1
		_build $1 $T_ORDER $X_ORDER

		for nx in 5 10 50 80 100 500 800 1000 5000
		do
			stdoutfile="RESLT/${X_ORDER}x${nx}_${T_ORDER}t${dt}.stdout"
			echo $stdoutfile
			_run $1 $nx $dt $2 $tshift $stdoutfile &
			pids+="$! "
		done

		for pid in $pids
		do
			wait $pid

			if [[ $? != 0 ]]
			then
				echo "run failed in dx analysis, exiting..."
				kill 0
				exit 1
			fi
		done
	done	

	./visualizer $1 b
}

function _main {
	if [[ $# != 3 ]]
	then
		echo "Invalid number of arguments, exiting"
		exit 1
	fi

	echo "Main running in $BASHPID"

	case $3 in
		"a") _standard $@ ;;
		"x") _dx_analysis $@ ;;
		"t") _dt_analysis $@ ;;
		"b" | "xt") _dxdt_analysis $@ ;;
		*) echo "Unknown profile" ;;
	esac
}

_main "$@"
