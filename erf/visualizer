#!/usr/bin/env python3

import os
import sys
import asyncio

import numpy as np
import matplotlib.pyplot as plt

from visualizer import Visualizer

class Viss:
	def __init__(self, prefix, resd, imgd, dxdt):
		self.data = {}
		for reslt in os.listdir(resd):
			if not os.path.isdir(f'{resd}/{reslt}'):
				continue

			if not os.path.exists(f'{imgd}/{reslt}'):
				os.mkdir(f'{imgd}{reslt}')
			
			print(f'Processing results in {resd}/{reslt}')
			vis = Visualizer(f'{resd}/{reslt}', f'{imgd}/{reslt}', prefix, times='times.dat')

			if dxdt == 'x' or dxdt == 'b':
				key = vis.config.x_order
			elif dxdt == 't':
				key = vis.config.t_order

			if key not in self.data.keys():
				self.data[key] = []
				
			self.data[key].append(vis)

