async def make_all(viss):
	async def _make(vis):
		vis.make_anim(
			fname='results.mp4',
			opts = {
				'soln': {
					'c': 'blue',
					'label': 'Numerical'
				},
				'exact_soln': {
					'c': 'red',
					'linestyle': '--',
					'label': 'Analytical'
				}
			},
			ax_options = {
				'ylim': [0.0, 2.0],
				'ylabel': 'Temperature-ish',
				'xlabel': 'x'
			}
		)

		vis.make_diffs_anim(
			fname='diffs.gif',
			prefixs=['exact_soln', 'soln'],
			ax_options = {
				'ylim': [-0.1, 0.1],
				'ylabel': 'Error',
				'xlabel': 'x'
			}
		)

		vis.plot_errors()
		vis.plot_error_norms()

	async with asyncio.TaskGroup() as tg:
		for vis in viss.values():
			tg.create_task(_make(vis))

if __name__ == '__main__':
	assert len(sys.argv) == 3
	assert sum(c1 == c2 for c1 in "abxt" for c2 in sys.argv[2]) > 0
	assert sum(c1 == c2 for c1 in "bxt" for c2 in sys.argv[2]) < 2

	viss = Viss(sys.argv[1], 'RESLT', 'imgs', sys.argv[2])

	funcs = {
		'a': lambda x: asyncio.run(make_all(x)),
		'b': lambda x: analyse_dxdt(x),
		't': lambda x: analyse_dt(x),
		'x': lambda x: analyse_dx(x)
	}

	for k in sys.argv[2]:
		funcs[k](viss)