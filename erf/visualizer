#!/usr/bin/env python3

import os
import sys

import numpy as np
import matplotlib.pyplot as plt

from visualizer import Visualizer

def main():
	viss = {}

	for reslt in os.listdir("RESLT"):
		if not os.path.isdir(f'RESLT/{reslt}'):
			continue

		if not os.path.exists(f"imgs/{reslt}"):
			os.mkdir(f'imgs/{reslt}')

		print(f'Processing results in RESLT/{reslt}')
		vis = Visualizer(f'RESLT/{reslt}', f'imgs/{reslt}', sys.argv[1], times='times.dat')

		viss[reslt] = vis
	
	return viss

def analyse_dx(viss):
	ns = np.zeros(len(viss.keys()))
	err_norms = np.zeros(len(viss.keys()))

	config = None

	for i, (k, v) in enumerate(viss.items()):
		ns[i] = v.config.nx

		print(f'{i} = {ns[i]}')

		err_norms[i] = v.get_error_norm()

		if i == 0:
			config = v.config
	
	xs = 1/ns

	ref_xs = np.logspace(-5, -1)
	ref_ys_1 = ref_xs * 1e-4
	ref_ys_2 = np.square(ref_xs)

	fig, ax = plt.subplots(1)

	ax.scatter(xs, err_norms, label='actual')
	plt.plot(ref_xs, ref_ys_1, label='reference (linear)', ls='--')
	plt.plot(ref_xs, ref_ys_2, label='reference (quadratic)', ls='--')

	plt.title(f'{sys.argv[1]} error analysis - X({config.x_order}), T({config.t_order})')
	ax.set_xscale('log')
	ax.set_yscale('log')
	ax.set_xlabel('dx')
	ax.set_ylabel('normalized norm of error')
	ax.legend()
	plt.savefig(f'imgs/{sys.argv[1]}_nx_errors.png')


if __name__ == '__main__':
	assert len(sys.argv) == 3

	viss = main()

	analyse_dx(viss)

	# exit(0)

	for _, vis in viss.items():
		vis.make_anim(
			fname='results.mp4',
			opts = {
				'soln': {
					'c': 'blue',
					'label': 'Numerical'
				},
				'exact_soln': {
					'c': 'red',
					'linestyle': '--',
					'label': 'Analytical'
				}
			},
			ax_options = {
				'ylim': [0.0, 2.0],
				'ylabel': 'Temperature-ish',
				'xlabel': 'x'
			}
		)

		vis.plot_errors()
		vis.plot_error_norms()

		vis.make_diffs_anim(
			fname='diffs.gif',
			prefixs=['exact_soln', 'soln'],
			ax_options = {
				'ylim': [-0.1, 0.1],
				'ylabel': 'Error',
				'xlabel': 'x'
			}
		)
	

	


