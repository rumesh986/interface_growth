def analyse_dx(viss):
	fig, ax = plt.subplots(1)

	config = None
	data = {}
	for order in viss.data.keys():
		data[order] = {
			'xs': np.zeros(len(viss.data[order])),
			'err_norms': np.zeros(len(viss.data[order]))
		}
	
	for order, series in viss.data.items():
		for i, vis in enumerate(series):
			data[order]['xs'][i] = 1/vis.config.nx
			data[order]['err_norms'][i] = vis.get_total_error_norm()

			if i == 0:
				config = vis.config
		
	for order, _ in data.items():
		print(f'plotting {order} scatter')
		ax.scatter(data[order]['xs'], data[order]['err_norms'], label=f'x_order={order}')

	ref_xs = np.logspace(-5, -1)
	ref_ys_1 = ref_xs * 1e-4
	ref_ys_2 = np.square(ref_xs)

	ax.plot(ref_xs, ref_ys_1, label='reference (linear)', ls='--')
	ax.plot(ref_xs, ref_ys_2, label='reference (quadratic)', ls='--')

	plt.title(f'{sys.argv[1]} dx error analysis T({config.t_order})')
	ax.set_xscale('log')
	ax.set_yscale('log')
	ax.set_xlabel('dx')
	ax.set_ylabel('Normalized norm of errors')
	ax.legend()
	plt.savefig(f'imgs/{sys.argv[1]}_dx_errors.png')

